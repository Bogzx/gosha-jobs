# Never bake secrets or local state into image layers. .env* covers
# .env.backup (restic password + remote credentials) and any .env.local;
# the template has no secrets and stays.
.env*
!.env.example
*.env
keys/
data/
migration/

# Not needed in images
.git/
.github/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
web/node_modules/
web/dist/
shots/
.superpowers/
.playwright-cli/
docs/

# Local-testing sign-in backdoor — must never exist in a production image
gosha/api/debug_login.py

# Multi-agent working notes and probes: repo-only
.agents/
