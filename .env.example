# ============================================================
#  GOSHA environment configuration
#  Copy to .env and fill in. Never commit the real .env.
# ============================================================

# --- Discord bot (required) ---------------------------------
DISCORD_TOKEN=your-bot-token-here
# Unused: ops alerts are owner DMs only (ALERT_DM_USER_IDS below). Kept
# parseable so an old .env still loads.
# ALERT_CHANNEL_ID=123456789012345678

# Comma-separated Discord user IDs with admin powers
# (find yours: Discord Settings > Advanced > Developer Mode, right-click yourself)
ADMIN_DISCORD_IDS=123456789012345678

# --- Scraper-failure alerts (gosha/alerts.py, docs/ALERTS.md) ---
# Failures (a board returning nothing or collapsing, a cycle with 0 jobs,
# descriptions or embeddings missing, a scheduled job crashing, the bot
# watchdog restarting a hung bot) are sent ONLY as a Discord DM from the
# bot to the IDs below, with a reminder per cooldown and a "recovered" DM.
# Nothing is posted to any channel; admins are NOT paged implicitly.
# Discord needs the NUMERIC user ID, not the username: Settings > Advanced
# > Developer Mode on, then right-click the user (e.g. @Bogdanila) > Copy
# User ID. The bot can only DM someone who shares a server with it and
# allows DMs from server members. Empty = alerts off.
# ALERT_DM_USER_IDS=123456789012345678
# The one off switch for every alert path (default true).
# ALERTS_ENABLED=true
# A condition that stays broken is repeated this often (minutes).
# ALERT_COOLDOWN_MINUTES=360

# --- Database -----------------------------------------------
# Default is SQLite for dev; docker-compose.prod.yml overrides
# this with Postgres for the containers automatically.
# DATABASE_URL=sqlite+aiosqlite:///data/jobs.db
POSTGRES_PASSWORD=

# --- Scheduler ----------------------------------------------
# SCRAPE_INTERVAL_MINUTES=60

# --- SSH proxy tunnels (optional, up to 9) ------------------
# Route JobSpy scraping through remote VPSs to dodge IP bans.
SSH_KEY_PATH=/home/app/.ssh/id_rsa
# VPS_1_HOST=111.111.111.111
# VPS_1_USER=ubuntu
# VPS_1_PORT=1080
# VPS_1_KEY=/home/app/.ssh/vps1.key
# VPS_1_SSH_PORT=22            # remote sshd port (e.g. a key-only sshd on a Tailscale IP)
#
# JobSpy also uses the server's own IP when this is on, shuffled together
# with the tunnels above; with no tunnel alive it still scrapes directly.
# SCRAPE_DIRECT=true
# Opt-in. When a native board (eJobs, BestJobs, Hipo, RemoteOK, Jobicy) answers 403
# to a plain request, retry it with a Chrome TLS fingerprint (curl_cffi, already
# installed with python-jobspy). BestJobs refuses Python TLS handshakes from some
# networks; this gets around that bot protection, so check the board terms first.
# SCRAPE_BROWSER_FALLBACK=false
# Opt-in. Every scrape cycle also runs a fixed baseline of native-board searches
# (eJobs, BestJobs, Hipo; RemoteOK/Jobicy/BestJobs for remote): 'junior developer'
# in Bucharest, Cluj, Timisoara, Iasi, Oradea, Romania and remote, whatever the
# subscriptions are, so the web feed has student-level jobs everywhere. No LinkedIn,
# Indeed or Glassdoor requests. Needs the pipeline side (gosha-pipe) to take effect.
# SCRAPE_BASELINE=false
# Host keys are trusted on first use and pinned here (~/.ssh is read-only);
# a key that later changes is refused. Keys you pre-pin in keys/known_hosts
# are honoured too. Delete a line here only after verifying the new key.
# GOSHA_SSH_KNOWN_HOSTS_FILE=/app/data/ssh_known_hosts

# --- Semantic matching --------------------------------------
# true/1/yes/on enable it, like every other on/off flag here.
USE_SEMANTIC_MATCHING=true
# Changing SEMANTIC_MODEL changes the vector space: every stored job and CV
# embedding must be recomputed (NULL jobs.embedding / users.cv_embedding and
# let the hourly backfill + next CV upload refill them), and the threshold
# re-tuned. Set it identically for the bot and api services.
# SEMANTIC_MODEL=all-mpnet-base-v2
# Discord delivery thresholds; unset = the values tuned on the offline eval
# (gosha/matching.py, docs/EVAL.md): 0.42 for a search alone, 0.43 for a
# search blended with the user's CV. Setting either pins it.
# SEMANTIC_THRESHOLD=0.42
# SEMANTIC_THRESHOLD_CV=0.43

# --- Salary normalisation (gosha/salary.py) ----------------
# Postings are compared in RON. Built-in rates (RON per 1 unit: EUR 5.0,
# USD 4.6, GBP 5.9, ...) are rough on purpose; override some or all as
# CODE:RON_PER_UNIT pairs, comma-separated. Unlisted currencies keep the
# built-in rate; a malformed entry is ignored (a bad number with a warning).
# GOSHA_FX_RATES=EUR:5.07,USD:4.71

# --- AI cover letters ---------------------------------------
# Provider auto-detect: DeepSeek when DEEPSEEK_API_KEY is set, then
# OpenRouter when OPENROUTER_API_KEY is set, Gemini otherwise.
# Force with LLM_PROVIDER=deepseek|openrouter|gemini.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# LLM_PROVIDER=

# --- Web platform (gosha.bogdantruta.com) -------------------
# Random long string for session cookies. REQUIRED, minimum 32 chars —
# the API refuses to start with anything shorter. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- CV storage ---------------------------------------------
# Fernet key that encrypts stored CVs at rest. REQUIRED outside development:
# the bot and api refuse to start without it. Same value for both services.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate by prepending a new key (NEW,OLD) and restarting: both services
# re-encrypt every CV under OLD at startup ("CV key rotation: re-encrypted N"
# in the logs). Drop OLD only after that. BACK IT UP apart from the data —
# losing it loses every CV.
CV_ENCRYPTION_KEY=
# Local development only: allow plaintext CVs when no key is set.
# GOSHA_ENV=development
# Delete CV data (file, embedding, cover letters) of users inactive this
# many months; 0 disables. Preview: python scripts/cv_retention.py --dry-run
# CV_RETENTION_MONTHS=12
# Delete events (page views, deliveries, sign-ins) older than this many
# months; 0/unset keeps them until the account is deleted. Never shorter
# than CV_RETENTION_MONTHS (CV retention reads activity from events).
# EVENT_RETENTION_MONTHS=0

# --- Privacy notice (/privacy, gosha/api/legal.py) -----------
# Who to contact about personal data: a URL or an email address.
# PRIVACY_CONTACT=https://bogdantruta.com
# The reverse proxy / CDN in front of the site, if any, is a processor
# that sees requests in plaintext. Known values: cloudflare.
# PRIVACY_EDGE_PROXY=cloudflare

# Force the Secure flag on session cookies. Leave unset to derive it from
# PUBLIC_BASE_URL; set to true when TLS is terminated upstream and
# PUBLIC_BASE_URL is http://.
# COOKIE_SECURE=
# OAuth2 credentials from the same Discord application as the bot
# (Developer Portal > OAuth2). Add the redirect URI there too:
#   https://gosha.bogdantruta.com/api/v1/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PUBLIC_BASE_URL=https://gosha.bogdantruta.com
# DISCORD_REDIRECT_URI=https://gosha.bogdantruta.com/api/v1/auth/discord/callback
# Server users get auto-joined into for DM alerts (+ fallback invite)
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=

# --- Backups (docs/BACKUPS.md — read it first) --------------
# The `backup` service is inert unless started with --profile backup.
# Its secrets do NOT go in this file: everything here also reaches the bot
# and the api. Put them in .env.backup (chmod 600), which only the backup
# service reads — docs/BACKUPS.md Step 3:
#   RESTIC_REPOSITORY=b2:gosha-backups:/
#   RESTIC_PASSWORD=          # openssl rand -base64 48 — KEEP A COPY OFF-BOX
#   B2_ACCOUNT_ID= / B2_ACCOUNT_KEY=
#   AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=   # S3-compatible instead
#   BACKUP_INTERVAL_SECONDS=86400
#   BACKUP_KEEP_DAILY=30
#   BACKUP_HEALTHCHECK_URL=   # dead-man switch, e.g. healthchecks.io

# --- Bot watchdog (gosha/heartbeat.py) ----------------------
# Docker restarts a process that exits, never one that is merely
# "unhealthy". When the scheduler stops running jobs for this many seconds
# (a wedged event loop) the bot dumps every thread's stack to its log and
# exits, so `restart: unless-stopped` brings it back. 0 disables it.
# GOSHA_WATCHDOG_SECONDS=900

# --- Resource limits ----------------------------------------
# torch sits around 2 GB RSS in each of bot and api.
# BOT_MEM_LIMIT=3g
# API_MEM_LIMIT=3g
# Networks uvicorn will trust X-Forwarded-For from. Default covers the
# default compose bridge; widen only if Caddy is somewhere else.
# TRUSTED_PROXY_IPS=172.16.0.0/12

# --- Reverse proxy mode -------------------------------------
# Standalone server (our Caddy owns 80/443 + TLS): leave unset.
# Behind an existing host proxy: uncomment both and point the
# host proxy at http://127.0.0.1:8090
# CADDY_SITE=:80
# CADDY_HTTP_BIND=127.0.0.1:8090
# CADDY_HTTPS_BIND=127.0.0.1:8443
# ...and trust that proxy for the client IP (it must overwrite
# X-Forwarded-For; see deploy/host-caddy.snippet). Unset = this Caddy faces
# Cloudflare: Cloudflare's ranges + CF-Connecting-IP.
# CADDY_EXTRA_TRUSTED_PROXIES=private_ranges
# CADDY_CLIENT_IP_HEADER=X-Forwarded-For
