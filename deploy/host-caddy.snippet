# Site block for a host-level Caddy that fronts GOSHA's container Caddy
# (bound to 127.0.0.1:8090) behind Cloudflare. It names the real client
# in X-Forwarded-For, which the container Caddy trusts from private ranges
# (CADDY_EXTRA_TRUSTED_PROXIES=private_ranges, CADDY_CLIENT_IP_HEADER=
# X-Forwarded-For). CF-Connecting-IP is believed only when the TCP peer is
# Cloudflare (published ranges: https://www.cloudflare.com/ips/, copied
# 2026-10-01); a request sent straight to the origin is named by its own
# address and any forged header is dropped. scripts/check_client_ip.sh
# tests this block.
{$GOSHA_HOST:gosha.bogdantruta.com} {
	@cloudflare remote_ip {$CLOUDFLARE_RANGES:173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32}
	handle @cloudflare {
		reverse_proxy {$GOSHA_UPSTREAM:localhost:8090} {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		reverse_proxy {$GOSHA_UPSTREAM:localhost:8090} {
			header_up X-Forwarded-For {remote_host}
			header_up -CF-Connecting-IP
		}
	}
}
