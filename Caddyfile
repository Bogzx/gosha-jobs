# Caddy config for the GOSHA web platform.
# CADDY_SITE defaults to the production domain (auto-HTTPS via Let's Encrypt).
# Behind an existing host reverse proxy, set CADDY_SITE=:80 and bind the
# container to localhost (see CADDY_HTTP_BIND in docker-compose.prod.yml).
#
# The real client IP, which the API rate-limits on (gosha/ratelimit.py).
#
# Only peers listed here may name the client in a header; anyone else -
# including a request sent straight to the origin with a forged
# CF-Connecting-IP - is identified by its own address. Default: Caddy faces
# Cloudflare, so trust Cloudflare's published ranges
# (https://www.cloudflare.com/ips/, copied 2026-10-01) and read
# CF-Connecting-IP.
#
# Behind a reverse proxy on the same host (production: the host Caddy
# forwards to 127.0.0.1:8090), set CADDY_EXTRA_TRUSTED_PROXIES=private_ranges
# and CADDY_CLIENT_IP_HEADER=X-Forwarded-For, and have that proxy overwrite
# X-Forwarded-For itself - README, "Running behind an existing reverse proxy".
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 {$CADDY_EXTRA_TRUSTED_PROXIES}
		client_ip_headers {$CADDY_CLIENT_IP_HEADER:CF-Connecting-IP}
		trusted_proxies_strict
	}
}

{$CADDY_SITE:gosha.bogdantruta.com} {
	encode gzip zstd

	# Hard ceiling on request bodies, enforced at the edge so an oversized
	# upload never reaches the API process at all. The application limit is
	# 5 MB (gosha/services/cv.py MAX_CV_BYTES); this leaves room for the
	# multipart envelope while still bounding memory.
	request_body {
		max_size 6MB
	}

	# API -> FastAPI container
	handle /api/* {
		reverse_proxy api:8000 {
			# Exactly one address, resolved above. uvicorn trusts this hop
			# (--forwarded-allow-ips), so whatever arrives here is what the
			# API sees as the client.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# SPA: static build with client-side routing fallback
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# One year, and the domain is HTTPS-only in practice.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# script-src is 'self' only — no third-party JS can execute, which
		# is the property that matters for a site holding CVs.
		#
		# The font and image origins below are the SPA's remaining
		# third-party dependencies (Google Fonts in web/index.html, Unsplash
		# hero art in web/src/pages/Landing.tsx). They leak visitor IPs and
		# should be self-hosted; until the assets are vendored, allowing
		# them here is the difference between a policy that works and one
		# that blanks the landing page. Tracked in PRIVACY.md.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com https://cdn.discordapp.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
}
